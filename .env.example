GOLD_TRADER_ENV=development
GOLD_TRADER_DATABASE_URL=sqlite:///var/gold_trader.sqlite3
GOLD_TRADER_HOST=127.0.0.1
GOLD_TRADER_PORT=8775
GOLD_TRADER_STARTING_EQUITY=10000
GOLD_TRADER_SESSION_SECRET=
# 120 seconds keeps one continuously running provider request under Twelve Data's 800/day free cap.
GOLD_TRADER_LIVE_PAPER__POLL_SECONDS=120
GOLD_TRADER_LIVE_PAPER__RECONNECT_INITIAL_SECONDS=10
GOLD_TRADER_LIVE_PAPER__RECONNECT_MAX_SECONDS=120
# API keys belong in macOS Keychain. These names are references, not secrets.
GOLD_TRADER_TWELVE_DATA_KEYRING_NAME=twelve-data
GOLD_TRADER_FRED_KEYRING_NAME=fred
